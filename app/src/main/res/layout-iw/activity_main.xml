<?xml version="1.0" encoding="utf-8"?>
<!-- Hebrew-only header positioning. Other languages use layout/activity_main.xml.
     Mirror of the tvOS 18 Home: menu bar platter at the top left, greeting and date to its right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_backdrop">

    <!-- Time-of-day backdrop, drawn once a minute (config.xml sky_intensity; 0 keeps it hidden).
         Keep in step with layout/activity_main.xml: every view there must exist here too. -->
    <com.appletv.launcher.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Top Shelf title (right-aligned for Hebrew), positioned above the dock in code. -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="45dp"
        android:layout_gravity="right"
        android:gravity="right"
        android:alpha="0"
        android:textColor="@color/tvos_label_primary"
        android:textSize="@dimen/tvos_text_title1"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:shadowColor="#73000000"
        android:shadowDy="1"
        android:shadowRadius="6"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="25dp">

        <!-- Header row, start-aligned: [menu bar platter: controls | clock] [date · greeting]. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="45dp"
            android:orientation="horizontal"
            android:gravity="left|center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="@dimen/tvos_menubar_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/menu_bar_bg">

                <LinearLayout
                    android:id="@+id/topButtons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnSettings"
                        style="@style/TopButton"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="2dp"
                        android:text="@string/settings"
                        android:drawableStart="@drawable/ic_settings"
                        android:nextFocusDown="@+id/grid" />

                    <TextView
                        android:id="@+id/btnWifi"
                        style="@style/TopButton"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="2dp"
                        android:maxWidth="160dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="@string/wifi"
                        android:drawableStart="@drawable/ic_wifi"
                        android:nextFocusDown="@+id/grid" />

                    <TextView
                        android:id="@+id/btnInputs"
                        style="@style/TopButton"
                        android:layout_marginStart="0dp"
                        android:text="@string/inputs"
                        android:drawableStart="@drawable/ic_input"
                        android:nextFocusDown="@+id/grid" />
                </LinearLayout>

                <!-- Time numerals stay left to right. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6.5dp"
                    android:layout_marginEnd="8.5dp"
                    android:orientation="horizontal"
                    android:layoutDirection="ltr">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#BFFFFFFF"
                        android:textSize="@dimen/tvos_text_caption1"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#BFFFFFFF"
                        android:textSize="@dimen/tvos_text_caption1"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="horizontal"
                android:gravity="left|center_vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Shamsi date ("27 Mehr 1405"), shown when shamsi_date is on. -->
                    <TextView
                        android:id="@+id/shamsiDate"
                        android:gravity="right"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="#E6FFFFFF"
                        android:textSize="@dimen/tvos_text_caption1"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:visibility="gone" />

                    <TextClock
                        android:id="@+id/date"
                        android:gravity="right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:format12Hour="@string/date_format"
                        android:format24Hour="@string/date_format"
                        android:textColor="#B3FFFFFF"
                        android:textSize="@dimen/tvos_text_caption1"
                        android:fontFamily="sans-serif-medium"
                        android:shadowColor="#73000000"
                        android:shadowDy="1"
                        android:shadowRadius="6" />
                </LinearLayout>

                <View
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/status_dot"
                    android:backgroundTint="#B3FFFFFF" />

                <TextView
                    android:id="@+id/greeting"
                    android:gravity="right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="#B3FFFFFF"
                    android:textSize="@dimen/tvos_text_caption1"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#73000000"
                    android:shadowDy="1"
                    android:shadowRadius="6" />
            </LinearLayout>
        </LinearLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/tvos_grid_inset"
                android:paddingEnd="@dimen/tvos_grid_inset"
                android:paddingTop="10dp"
                android:paddingBottom="6dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.appletv.launcher.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
