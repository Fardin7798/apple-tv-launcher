<?xml version="1.0" encoding="utf-8"?>
<!-- Home Screen Cards (Module cards) list under the Settings control, as a tvOS 18 platter;
     scrolls when the rows don't fit on a 720p screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:padding="@dimen/tvos_panel_padding"
    android:elevation="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:text="@string/module_cards"
        android:textColor="@color/tvos_label_primary"
        android:textSize="@dimen/tvos_text_headline"
        android:fontFamily="sans-serif-black"
        android:singleLine="true"
        android:ellipsize="end" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
