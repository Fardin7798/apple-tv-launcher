<?xml version="1.0" encoding="utf-8"?>
<!-- Control Center / Inputs tile: 48dp tile (96px) inside a 56dp row, the 8dp gap comes from input_row_bg's inset.
     Icon 22dp, title Body (29px) medium, status Caption 1. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:background="@drawable/input_row_bg"
    android:stateListAnimator="@animator/tvos_focus_control"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:tint="@drawable/pill_text"
        android:duplicateParentState="true"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:textColor="@drawable/pill_text"
        android:duplicateParentState="true"
        android:textSize="@dimen/tvos_text_body"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:ellipsize="end" />

    <View
        android:id="@+id/dot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/status_dot" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@drawable/pill_text_dim"
        android:duplicateParentState="true"
        android:textSize="@dimen/tvos_text_caption1"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
