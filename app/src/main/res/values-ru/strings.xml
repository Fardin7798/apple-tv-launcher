    <string name="card_prompt_title">Новая карточка от %1$s</string>
    <string name="card_prompt_body">%1$s может показывать карточку на главном экране. Если оставить её скрытой, обычная плитка приложения не изменится.</string>
    <string name="card_prompt_names">Карточка: «%1$s». Приложение: «%2$s».</string>
