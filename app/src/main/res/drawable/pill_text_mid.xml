<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary lines of a focused list row (package, signing key): dark enough to read on the white
     focused tile at 11sp; unfocused the same as pill_text_dim. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#BF000000" />
    <item android:color="#80FFFFFF" />
</selector>
