<?xml version="1.0" encoding="utf-8"?>
<!-- Stand-alone glass capsule (material platter); white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tvos_button_focused" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tvos_material" />
            <stroke android:width="0.5dp" android:color="@color/tvos_material_stroke" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</selector>
