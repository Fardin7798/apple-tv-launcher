<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS Settings row: focused white (with lift from the style's animator), selected value tvOS blue,
     otherwise a faint fill quaternary (white 8%). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tvos_blue" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tvos_fill_quaternary" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
