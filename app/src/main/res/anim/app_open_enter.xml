<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS app launch: the app zooms up from the icon and fades in. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/tvos_ease"
    android:duration="320">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" />
    <scale android:fromXScale="0.88" android:toXScale="1.0"
        android:fromYScale="0.88" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" />
</set>
