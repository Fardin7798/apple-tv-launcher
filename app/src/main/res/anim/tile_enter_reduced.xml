<?xml version="1.0" encoding="utf-8"?>
<!-- Reduced motion: short fade with a small rise, no overshoot. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/tvos_ease"
    android:duration="180">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" />
    <translate android:fromYDelta="4%" android:toYDelta="0%" />
    <scale
        android:fromXScale="0.98" android:toXScale="1.0"
        android:fromYScale="0.98" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" />
</set>
