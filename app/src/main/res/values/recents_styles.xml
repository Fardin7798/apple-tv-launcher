<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Spider Recents: glass pills (Inter), keycaps (Oswald), hints (Inter). -->
    <style name="RecentsPill">
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">17dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:fontFamily">@font/spider_inter_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#F0EEFC</item>
    </style>
    <style name="RecentsAction">
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:fontFamily">@font/spider_inter_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textColor">#F0EEFC</item>
    </style>
    <style name="RecentsKey">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">21dp</item>
        <item name="android:minWidth">23dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">7dp</item>
        <item name="android:paddingEnd">7dp</item>
        <item name="android:fontFamily">@font/spider_oswald_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#EBE8FA</item>
    </style>
    <style name="RecentsHint">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">7dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:fontFamily">@font/spider_inter_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#AAA6C8</item>
    </style>
</resources>
